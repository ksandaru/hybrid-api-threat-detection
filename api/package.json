{
  "name": "api-threat-detection-api",
  "version": "0.1.0",
  "description": "REST API + hybrid rule/ML detection middleware",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "npm run test:parity",
