# The virtualenv is a host artefact; the image installs its own dependencies.
venv/
.venv/
__pycache__/
*.pyc

# Models are supplied at runtime by a bind mount, not baked into the image.
# They are large (the Random Forest alone is 259 MB) and are not in version
# control, so a fresh clone could not build an image containing them anyway.
models/

notebooks/
*.md
