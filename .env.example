# Copy to .env and adjust. Every value below is a default that the code
# already applies when the variable is absent, so an empty .env still runs.

# ---------------------------------------------------------------- API
PORT=3000
ML_SERVICE_URL=http://localhost:8000
DATABASE_URL=postgres://detector:detector123@localhost:5432/api_threat_detection
JWT_SECRET=change-me-in-local-env

# ---------------------------------------------------- Detection behaviour
# off    - middleware records nothing and blocks nothing (baseline runs)
# rules  - signature engine only, no call to the inference service
# hybrid - signature engine plus the classifier, combined per COMBINE_STRATEGY
DETECTION_MODE=rules

# Combined score at or above this blocks the request.
DETECTION_THRESHOLD=0.7

# How the rule score and the ML score are merged (hybrid mode only):
# noisy_or | weighted | max | rules_only
COMBINE_STRATEGY=noisy_or

# Weights for COMBINE_STRATEGY=weighted. Ignored by the other strategies.
W_RULE=0.5
W_ML=0.5

# Budget for one inference call. On timeout the request is judged on rules
# alone (fail-open, NFR2). Under Compose a stopped container swallows the
# connection rather than refusing it, so this is paid in full per request
# during an outage.
ML_TIMEOUT_MS=250

# Set to 1 to attach the per-rule breakdown and both sub-scores to the
# response. Diagnostic only: it discloses detection logic to the caller.
DETECTION_TRACE=0

# ------------------------------------------------- Inference service (ml)
# All four default to the values recorded in the trained artefact. Leave
# unset unless deliberately overriding a trained parameter.
# W_RF=0.4
# W_XGB=0.4
# W_ISO=0.2
# ML_ATTACK_THRESHOLD=0.77
